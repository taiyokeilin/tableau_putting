          <datasource-dependencies datasource='federated.1e2tc3v1ts4a6i14lw1bm1ey2j1v'>
            <column caption='inside_10_pct' datatype='integer' name='[Calculation_1192679899952537600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Distance Left] &lt;= [Distance to Hole] * 0.1) OR ISNULL([Distance Left])&#10;THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='made_putt' datatype='integer' name='[Calculation_1192679899958390787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Distance Left] = 0 or ISNULL([Distance Left]) THEN 1 ELSE 0 END' />
            </column>
            <column caption='SUM([inside_10_pct]) / COUNT([tk_putting.csv])' datatype='real' name='[Calculation_1192679900272668682]' role='measure' type='quantitative' user:unnamed='Sheet 4'>
              <calculation class='tableau' formula='SUM([Calculation_1192679899952537600]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_A6D1EC00C2304F60A9DD9FA177919DDD])' />
            </column>
            <column caption='SUM([made_putt]) / COUNT([tk_putting.csv])' datatype='real' name='[Calculation_1192679900272697355]' role='measure' type='quantitative' user:unnamed='Sheet 4'>
              <calculation class='tableau' formula='SUM([Calculation_1192679899958390787]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_A6D1EC00C2304F60A9DD9FA177919DDD])' />
            </column>
            <column caption='is_3_putt' datatype='integer' name='[Calculation_1192679900277821457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Total Putts] &gt; 2 THEN 1 ELSE 0 END' />
            </column>
            <column caption='SUM([is_3_putt]) / COUNT([tk_putting.csv])' datatype='real' name='[Calculation_1192679900277944338]' role='measure' type='quantitative' user:unnamed='close/make by distance'>
              <calculation class='tableau' formula='SUM([Calculation_1192679900277821457]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_A6D1EC00C2304F60A9DD9FA177919DDD])' />
            </column>
            <column caption='dist_2' datatype='string' name='[Calculation_2991797533294891008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Distance to Hole] &gt; 40 THEN &quot;&gt;40&quot;&#10;ELSEIF [Distance to Hole] &gt; 25 AND [Distance to Hole] &lt;= 40 THEN &quot;25-40&quot;&#10;ELSEIF [Distance to Hole] &gt; 15 AND [Distance to Hole] &lt;= 25 THEN &quot;15-25&quot;&#10;ELSEIF [Distance to Hole] &gt; 6 AND [Distance to Hole] &lt;= 15 THEN &quot;6-15&quot;&#10;ELSEIF [Distance to Hole] &gt; 3 AND [Distance to Hole] &lt;= 6 THEN &quot;3-6&quot;&#10;ELSE &quot;&lt;=3&quot;&#10;END' />
            </column>
