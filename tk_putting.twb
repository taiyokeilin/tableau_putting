      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1e2tc3v1ts4a6i14lw1bm1ey2j1v].[usr:Calculation_1192679900272668682:qk]&quot;' value='Close %' />
