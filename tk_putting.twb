          <alias key='&quot;[federated.1e2tc3v1ts4a6i14lw1bm1ey2j1v].[usr:Calculation_1192679900277944338:qk]&quot;' value='3-Putt %' />
        </aliases>
      </column>
      <column caption='inside_10_pct' datatype='integer' name='[Calculation_1192679899952537600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Distance Left] &lt;= [Distance to Hole] * 0.1) OR ISNULL([Distance Left])&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Distance Bucket (ft.)' datatype='string' name='[Calculation_1192679899953614849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Distance to Hole] &gt; 50 THEN &quot;&gt;50&quot;&#10;ELSEIF [Distance to Hole] &gt; 40 AND [Distance to Hole] &lt;= 50 THEN &quot;40-50&quot;&#10;ELSEIF [Distance to Hole] &gt; 30 AND [Distance to Hole] &lt;= 40 THEN &quot;30-40&quot;&#10;ELSEIF [Distance to Hole] &gt; 20 AND [Distance to Hole] &lt;= 30 THEN &quot;20-30&quot;&#10;ELSEIF [Distance to Hole] &gt; 12 AND [Distance to Hole] &lt;= 20 THEN &quot;12-20&quot;&#10;ELSEIF [Distance to Hole] &gt; 6 AND [Distance to Hole] &lt;= 12 THEN &quot;6-12&quot;&#10;ELSEIF [Distance to Hole] &gt; 3 AND [Distance to Hole] &lt;= 6 THEN &quot;3-6&quot;&#10;ELSE &quot;&lt;=3&quot;&#10;END' />
      </column>
      <column caption='made_putt' datatype='integer' name='[Calculation_1192679899958390787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Distance Left] = 0 or ISNULL([Distance Left]) THEN 1 ELSE 0 END' />
      </column>
      <column caption='Slope (Down / Up)' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1192679900275105804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Down/Up])' />
      </column>
      <column caption='Break (Left / Right)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1192679900275187725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Left/Right])' />
      </column>
      <column caption='is_3_putt' datatype='integer' name='[Calculation_1192679900277821457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Total Putts] &gt; 2 THEN 1 ELSE 0 END' />
      </column>
      <column caption='is_current_year' datatype='integer' name='[Calculation_1192679900279566355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([Calculation_1192679900279963669]) = [Calculation_1192679900279803924] THEN 1 ELSE 0 END' />
      </column>
      <column caption='max_year' datatype='integer' name='[Calculation_1192679900279803924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(YEAR([Date]))' />
      </column>
      <column caption='current_year' datatype='integer' name='[Calculation_1192679900279963669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Date])' />
      </column>
      <column caption='Year' datatype='string' datatype-customized='true' name='[Calculation_1192679901988872222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([Date]))' />
      </column>
      <column caption='dist_2' datatype='string' name='[Calculation_2991797533294891008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Distance to Hole] &gt; 40 THEN &quot;&gt;40&quot;&#10;ELSEIF [Distance to Hole] &gt; 25 AND [Distance to Hole] &lt;= 40 THEN &quot;25-40&quot;&#10;ELSEIF [Distance to Hole] &gt; 15 AND [Distance to Hole] &lt;= 25 THEN &quot;15-25&quot;&#10;ELSEIF [Distance to Hole] &gt; 6 AND [Distance to Hole] &lt;= 15 THEN &quot;6-15&quot;&#10;ELSEIF [Distance to Hole] &gt; 3 AND [Distance to Hole] &lt;= 6 THEN &quot;3-6&quot;&#10;ELSE &quot;&lt;=3&quot;&#10;END' />
      </column>
      <column caption='color_inside_6' datatype='string' name='[Calculation_3366581526219427840]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_1192679899958390787]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_A6D1EC00C2304F60A9DD9FA177919DDD]) &gt;= 0.85 THEN &quot;1&quot;&#10;ELSEIF SUM([Calculation_1192679899958390787]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_A6D1EC00C2304F60A9DD9FA177919DDD]) &gt;= 0.7 THEN &quot;2&quot;&#10;ELSE &quot;3&quot;&#10;END' />
      </column>
      <column caption='color_6_12' datatype='string' name='[Calculation_3366581526220034049]' role='measure' type='nominal'>
