      <column caption='Slope (Down / Up)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1192679900275105804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Down/Up])' />
      </column>
      <column caption='color_inside_6' datatype='string' name='[Calculation_3366581526219427840]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_5626262579945394184]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_13D78640D78A444F9F306A64767A959F]) &gt;= 0.85 THEN &quot;1&quot;&#10;ELSEIF SUM([Calculation_5626262579945394184]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_13D78640D78A444F9F306A64767A959F]) &gt;= 0.7 THEN &quot;2&quot;&#10;ELSE &quot;3&quot;&#10;END' />
      </column>
      <column caption='num_putts' datatype='integer' name='[Calculation_3366581526228328458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Date (copy)_5626262579944005633], [Course], [Head Up], [Practice], [Calculation_5626262579943931904] : COUNTD([Putt ID])}' />
      </column>
      <column caption='Distance Bucket (ft.)' datatype='string' name='[Calculation_5626262579943931904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Distance to Hole] &gt; 40 THEN &quot;&gt;40&quot;&#10;ELSEIF [Distance to Hole] &gt; 25 AND [Distance to Hole] &lt;= 40 THEN &quot;25-40&quot;&#10;ELSEIF [Distance to Hole] &gt; 15 AND [Distance to Hole] &lt;= 25 THEN &quot;15-25&quot;&#10;ELSEIF [Distance to Hole] &gt; 6 AND [Distance to Hole] &lt;= 15 THEN &quot;6-15&quot;&#10;ELSEIF [Distance to Hole] &gt; 3 AND [Distance to Hole] &lt;= 6 THEN &quot;3-6&quot;&#10;ELSE &quot;&lt;=3&quot;&#10;END' />
      </column>
      <column caption='Break (Left / Right)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5626262579944280066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Left/Right])' />
      </column>
      <column caption='Slope (Down  / Up)' datatype='real' name='[Calculation_5626262579944419331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Down/Up])' />
      </column>
      <column caption='color_20_40' datatype='string' name='[Calculation_5626262579944640516]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_5626262579945525257]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_13D78640D78A444F9F306A64767A959F]) &gt;= 0.75 THEN &quot;1&quot;&#10;ELSEIF SUM([Calculation_5626262579945525257]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_13D78640D78A444F9F306A64767A959F]) &gt;= 0.5 THEN &quot;2&quot;&#10;ELSE &quot;3&quot;&#10;END' />
      </column>
      <column caption='color_30_plus' datatype='string' name='[Calculation_5626262579945127941]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_5626262579945676810]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_13D78640D78A444F9F306A64767A959F]) &lt;= 0.2 THEN &quot;1&quot;&#10;ELSEIF SUM([Calculation_5626262579945676810]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_13D78640D78A444F9F306A64767A959F]) &lt; 0.33 THEN &quot;2&quot;&#10;ELSE &quot;3&quot;&#10;END' />
      </column>
      <column caption='color_06_10' datatype='string' name='[Calculation_5626262579945222150]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_5626262579945394184]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_13D78640D78A444F9F306A64767A959F]) &gt;= 0.33 THEN &quot;1&quot;&#10;ELSEIF SUM([Calculation_5626262579945394184]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_13D78640D78A444F9F306A64767A959F]) &gt;= 0.2 THEN &quot;2&quot;&#10;ELSE &quot;3&quot;&#10;END' />
      </column>
      <column caption='color_06_minus' datatype='string' name='[Calculation_5626262579945320455]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_5626262579945394184]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_13D78640D78A444F9F306A64767A959F]) &gt;= 0.85 THEN &quot;1&quot;&#10;ELSEIF SUM([Calculation_5626262579945394184]) / COUNT([__tableau_internal_object_id__].[tk_putting.csv_13D78640D78A444F9F306A64767A959F]) &gt;= 0.7 THEN &quot;2&quot;&#10;ELSE &quot;3&quot;&#10;END' />
      </column>
      <column caption='made_putt' datatype='integer' name='[Calculation_5626262579945394184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Distance Left] = 0 or ISNULL([Distance Left]) THEN 1 ELSE 0 END' />
      </column>
      <column caption='inside_10_pct' datatype='integer' name='[Calculation_5626262579945525257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Distance Left] &lt;= [Distance to Hole] * 0.1) OR ISNULL([Distance Left])&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='is_3_putt' datatype='integer' name='[Calculation_5626262579945676810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Total Putts] &gt; 2 THEN 1 ELSE 0 END' />
      </column>
      <column caption='inside_2_ft' datatype='integer' name='[Calculation_5626262580372840465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Distance Left] &lt;= 2 THEN 1 ELSE 0 END' />
      </column>
      <column caption='is_close' datatype='integer' name='[Calculation_5626262580372983826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Distance to Hole] &lt;= 25 THEN [Calculation_5626262580372840465] ELSE [Calculation_5626262579945525257] END' />
      </column>
      <column caption='secondary_dist_bucket' datatype='string' name='[Calculation_5626262580742955033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Distance to Hole] &gt; 20 THEN &quot;20+&quot;&#10;ELSEIF [Distance to Hole] &gt; 10 THEN &quot;10-20&quot;&#10;ELSEIF [Distance to Hole] &gt;= 2 THEN &quot;&lt;=10&quot;&#10;ELSE &quot;&lt;2&quot;&#10;END' />
      </column>
      <column caption='putt_results_score' datatype='integer' name='[Calculation_5626262580744089626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5626262580742955033] = &quot;&lt;=10&quot; AND [Calculation_5626262579945394184] = 1 THEN 100&#10;ELSEIF [Calculation_5626262580742955033] IN (&quot;10-20&quot;, &quot;20+&quot;) and [Calculation_5626262580372983826] = 1 THEN 100&#10;ELSE 0&#10;END' />
      </column>
      <column caption='putt_process_score' datatype='integer' name='[Calculation_5626262580745015323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Good Speed Read] * 20 + [Good Line Read] * 20 + [Good Speed Execution] * 30 + [Good Line Execution] * 30' />
      </column>
      <column caption='putt_putting_score' datatype='real' name='[Calculation_5626262580745134108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5626262580744089626] * 0.25 + [Calculation_5626262580745015323] * 0.75' />
      </column>
      <column caption='date_course_hole' datatype='string' name='[Calculation_5626262580758376477]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Date]) + &apos; &apos; + [Course] + &apos; &apos; + STR([Hole])' />
      </column>
      <column caption='date_course' datatype='string' name='[Calculation_5626262580994179107]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Date]) + &apos; &apos; + [Course]' />
      </column>
      <column caption='Year' datatype='integer' name='[Date (copy)_5626262579944005633]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([Date])' />
      </column>
