            <column caption='Distance Bucket (ft.)' datatype='string' name='[Calculation_5626262579943931904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Distance to Hole] &gt; 40 THEN &quot;&gt;40&quot;&#10;ELSEIF [Distance to Hole] &gt; 25 AND [Distance to Hole] &lt;= 40 THEN &quot;25-40&quot;&#10;ELSEIF [Distance to Hole] &gt; 15 AND [Distance to Hole] &lt;= 25 THEN &quot;15-25&quot;&#10;ELSEIF [Distance to Hole] &gt; 6 AND [Distance to Hole] &lt;= 15 THEN &quot;6-15&quot;&#10;ELSEIF [Distance to Hole] &gt; 3 AND [Distance to Hole] &lt;= 6 THEN &quot;3-6&quot;&#10;ELSE &quot;&lt;=3&quot;&#10;END' />
            </column>
            <column caption='made_putt' datatype='integer' name='[Calculation_5626262579945394184]' role='measure' type='quantitative'>
